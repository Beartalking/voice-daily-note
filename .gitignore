# Audio files (large, not tracked)
Recording/*.wav
Recording/*.m4a
Recording/*.mp3
archive/

# Intermediate products (regenerable)
transcripts/

# Runtime logs
logs/

# Concurrency lock (recreated per run; the ledger it guards stays tracked)
.text_inbox.lock
.plaud_sync.lock
# Plaud ledger stays local: its paths carry meeting titles (client names), repo is public
.plaud_sync_ledger.json

# Sharing pipeline (input/output)
sharing_input/
sharing_output/

# Environment / secrets
.env

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
